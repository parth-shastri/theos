    {
      "type": "text",
      "id": "holds_text",
      "x": 297,
      "y": 324,
      "width": 518.4,
      "height": 90.0,
      "text": "Clamp counts to the available shared pools.\nDelegates share research; summaries share S.\nHold summaries for final responses if available.\nRelease unused delegate holds when it finishes.",
