# Assistant display name and model identity.
AGENT_NAME=Theos
# Copy to .env. Generate a different browser token for each user.
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-6-luna
AGENT_API_KEY=replace-me
AGENT_USERS={"owner":"replace-with-at-least-32-random-characters"}
AGENT_ADMINS=["owner"]
AGENT_FRONTEND_SECRET=replace-with-a-different-32-character-random-secret
AGENT_WEB_URL=http://127.0.0.1:8080
AGENT_TIMEZONE=Asia/Kolkata
# Optional Telegram polling and /start enrollment, limited to 50 users.
# AGENT_TELEGRAM_TOKEN=replace-me
# Set the HTTPS browser origin to offer web access after Telegram setup.
# AGENT_WEB_URL=https://theos.example.com
# Set a deployment-specific password to require /start <access-code>.
# AGENT_TELEGRAM_ACCESS_CODE=
# AGENT_TELEGRAM_USERS=[]
# AGENT_TELEGRAM_MAX_USERS=50
# Leave the sender allowlist empty to enroll users through the bot and SQLite.
