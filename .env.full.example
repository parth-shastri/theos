# Assistant display name and model identity.
AGENT_NAME=Theos
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-6-luna
AGENT_API_KEY=replace-me
AGENT_MODEL_BASE_URL=
# Empty uses the provider's model choices. OpenRouter includes all seven aliases.
AGENT_ALLOWED_MODELS=[]
AGENT_REASONING=default
AGENT_AUTO_TITLES=true
AGENT_USERS={"owner":"replace-with-at-least-32-random-characters"}
AGENT_ADMINS=["owner"]
# HTTPS browser origin used for Telegram onboarding links.
AGENT_WEB_URL=
AGENT_TIMEZONE=Asia/Kolkata
AGENT_HOST=127.0.0.1
AGENT_PORT=8080
AGENT_DATA_DIR=.theos
# Optional terminal client settings. Use the same URL and token as browser login.
AGENT_SERVER_URL=
AGENT_SERVER_TOKEN=
AGENT_MAX_CONCURRENT_TURNS=4
AGENT_MAX_MODEL_CALLS=12
AGENT_TURN_TIMEOUT=300
AGENT_CONTEXT_TOKENS=24000
AGENT_MAX_UPLOAD_BYTES=10485760
# Costs are optional estimates in USD per million tokens. Set current model rates.
# AGENT_INPUT_COST_PER_MILLION=0
# AGENT_OUTPUT_COST_PER_MILLION=0
AGENT_TELEGRAM_TOKEN=
AGENT_TELEGRAM_ACCESS_CODE=
AGENT_TELEGRAM_USERS=[]
AGENT_TELEGRAM_MAX_USERS=50
AGENT_TELEGRAM_CHATS=[]
AGENT_MEMORY__ENABLED=false
AGENT_MEMORY__AUTO_RETRIEVE=true
AGENT_MEMORY__RETRIEVAL_LIMIT=5
AGENT_MEMORY__RETRIEVAL_CHARS=4000
AGENT_MEMORY__RETRIEVAL_TIMEOUT=3
AGENT_MEMORY__CONSOLIDATION_TURNS=5
AGENT_MEMORY__CONSOLIDATION_INTERVAL=600
AGENT_MAX_SCHEDULED_TASKS=50
AGENT_MEMORY__ENDPOINT=http://memory.example.internal:8000
AGENT_MEMORY__API_KEY=
AGENT_MEMORY__TIMEOUT=15
AGENT_MEMORY__AUTH_HEADER=X-API-Key
AGENT_MEMORY__AUTH_PREFIX=
AGENT_EXA_KEY=
AGENT_BRAVE_KEY=
AGENT_SANDBOX__ENABLED=false
AGENT_SANDBOX__DOMAIN=sandbox.example.internal:8080
AGENT_SANDBOX__API_KEY=
AGENT_SANDBOX__USE_SERVER_PROXY=false
AGENT_SANDBOX__IMAGE=opensandbox/code-interpreter:v1.0.1
AGENT_SANDBOX__TIMEOUT_SECONDS=600
AGENT_STORAGE__ENDPOINT=
AGENT_STORAGE__BUCKET=
AGENT_STORAGE__ACCESS_KEY=
AGENT_STORAGE__SECRET_KEY=
AGENT_TRANSCRIPTION_URL=
AGENT_TRANSCRIPTION_KEY=
AGENT_TRANSCRIPTION_MODEL=whisper-1
AGENT_KOKORO_URL=
AGENT_KOKORO_VOICE=af_heart
AGENT_GMAIL__CLIENT_ID=
AGENT_GMAIL__CLIENT_SECRET=
AGENT_GMAIL__REDIRECT_URI=
AGENT_HEALTH__CLIENT_ID=
AGENT_HEALTH__CLIENT_SECRET=
AGENT_HEALTH__REDIRECT_URI=
AGENT_TOKEN_ENCRYPTION_KEY=
AGENT_HEALTH_INTERVAL=43200
AGENT_ZEPTO_URL=
AGENT_ZEPTO_REDIRECT_URI=http://localhost/callback
# AGENT_SKILLS_DIR=/data/skills
HOST_BIND_IP=127.0.0.1
HOST_PORT=8080
AGENT_MEMORY_LIMIT=768m
AGENT_CPU_LIMIT=1.0
AGENT_IMAGE=theos:local
AGENT_DATA_VOLUME=theos-data
