AGENT_CALLING_API_ID=
AGENT_CALLING_API_HASH=
# Generate a fresh shared key with: openssl rand -hex 32
AGENT_CALLING_KEY=
# The receiving personal Telegram account's numeric user ID, not its phone number.
AGENT_CALLING_RECIPIENTS=[123456789]
AGENT_CALLING_DATA_DIR=/absolute/private/path/theos-calling
# Use the host's private Tailscale address when the Pi connects remotely.
AGENT_CALLING_HOST=127.0.0.1
AGENT_CALLING_PORT=8882
AGENT_CALLING_DAILY_LIMIT=20

# Optional login-only values. A username can be resolved before numeric recipients are configured.
AGENT_CALLING_PHONE=
AGENT_CALLING_RECIPIENT_USERNAME=
