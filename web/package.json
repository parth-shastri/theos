{
  "name": "theos-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/standalone.mjs",
    "openui:generate": "node src/openui/generate.mjs",
    "openui:check": "node src/openui/generate.mjs --check",
    "check": "prettier --check \"src/**/*.{js,jsx,mjs}\" scripts tests next.config.mjs playwright.config.mjs package.json",
    "start": "node .next/standalone/server.js",
    "test": "node --conditions=react-server --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@openuidev/react-lang": "1.0.1",
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.6.2"
  }
}
